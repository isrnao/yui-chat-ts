# -----------------------------------------------------------------------------
# ブラウザ公開設定
# VITE_* はクライアントbundleに埋め込まれます。秘密値を設定しないでください。
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# New Relic Browser Agent（任意。5項目すべて設定した場合だけ有効）
VITE_NEW_RELIC_ACCOUNT_ID=
VITE_NEW_RELIC_TRUST_KEY=
VITE_NEW_RELIC_AGENT_ID=
VITE_NEW_RELIC_BROWSER_KEY=
VITE_NEW_RELIC_APP_ID=

# -----------------------------------------------------------------------------
# Storybook / Chromatic
# ローカルpublish用。CIではGitHub Actions Secretへ登録してください。
# -----------------------------------------------------------------------------
CHROMATIC_PROJECT_TOKEN=

# -----------------------------------------------------------------------------
# Supabase Edge Function Secrets
# ルート.envはローカル参照用です。本番値はSupabase Secretsへ別途登録してください。
# JEV_API_TOKENまたはGITHUB_TOKENがない場合、保存は継続してtriageだけskipします。
# -----------------------------------------------------------------------------
JEV_API_TOKEN=
GITHUB_TOKEN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_REGION=US

# 任意: Edge telemetry設定
# 空ならregionに応じたNew Relic既定endpointを使います。
OTEL_EXPORTER_OTLP_ENDPOINT=
DEPLOYMENT_ENVIRONMENT=

# local / staging専用。attempt1で初回保存だけを失敗させます。本番では無視されます。
SAVE_CHAT_FAULT_INJECT=

# -----------------------------------------------------------------------------
# ローカル運用スクリプト
# New Relic alert・trace確認・PagerDuty destination設定でのみ使用する秘密値です。
# -----------------------------------------------------------------------------
NEW_RELIC_USER_API_KEY=
PAGERDUTY_INTEGRATION_KEY=

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY はSupabaseがEdge Functionへ自動提供するため、
# このファイルには追加しません。
