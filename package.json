{
  "name": "yui-chat-ts",
  "private": false,
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "description": "お気楽チャットTSは放課後学生タウンの雰囲気を楽しめる無料のブラウザチャットです。",
  "keywords": [
    "お気楽チャットTS",
    "放課後学生タウン",
    "お気楽チャット",
    "無料チャット",
    "ブラウザチャット",
    "リアルタイムチャット",
    "学生チャット",
    "オンラインチャット",
    "react",
    "typescript",
    "vite",
    "chat",
    "realtime"
  ],
  "homepage": "https://www.okiraku.chat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/isrnao/yui-chat-ts.git"
  },
  "author": "お気楽チャットTS開発チーム",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "pnpm run generate:sitemap && tsc -b && vite build && pnpm run build:ssr && pnpm run prerender:rooms",
    "generate:sitemap": "node --experimental-strip-types scripts/generate-sitemap.ts",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender:rooms": "node --experimental-strip-types scripts/prerender-rooms.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "preview": "vite preview",
    "predeploy": "pnpm run build:prod",
    "deploy": "gh-pages -d dist --dotfiles",
    "test": "vitest run",
    "contracts:export": "UPDATE_CONTRACTS=1 vitest run src/test/contracts.test.ts --coverage.enabled=false",
    "watch:test": "vitest",
    "test:ui": "vitest run --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "lighthouse": "lighthouse https://www.okiraku.chat/ --output html --output-path ./lighthouse-report.html",
    "lighthouse:mobile": "lighthouse https://www.okiraku.chat/ --output html --output-path ./lighthouse-mobile.html --emulated-form-factor=mobile",
    "lighthouse:desktop": "lighthouse https://www.okiraku.chat/ --output html --output-path ./lighthouse-desktop.html --emulated-form-factor=desktop",
    "lighthouse:json": "lighthouse https://www.okiraku.chat/ --output json --output-path ./lighthouse-data.json",
    "lighthouse:ci": "lighthouse https://www.okiraku.chat/ --output json --quiet --chrome-flags='--headless'",
    "analyze:bundle": "npx vite-bundle-analyzer dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "chromatic:dryrun": "dotenv -e .env -- chromatic --dry-run --debug",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@newrelic/browser-agent": "1.323.0",
    "@supabase/functions-js": "2.117.3",
    "@supabase/postgrest-js": "2.117.3",
    "@supabase/realtime-js": "2.117.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "~7.29.7",
    "@chromatic-com/storybook": "^5.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chromatic": "^18.12.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "10.6.1",
    "fast-check": "^4.10.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "lighthouse": "^13.5.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
